# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=your-256-bit-secret-key-replace-in-production
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/card_crypto_db
DATABASE_POOL_SIZE=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Exchange APIs ─────────────────────────────────────────────────────────────
BINANCE_API_KEY=your-binance-api-key
BINANCE_API_SECRET=your-binance-api-secret
COINBASE_API_KEY=your-coinbase-api-key
COINBASE_API_SECRET=your-coinbase-api-secret

# ── PCI Security ──────────────────────────────────────────────────────────────
CARD_TOKENIZATION_KEY=replace-with-secure-tokenization-key-256bit
PCI_ENCRYPTION_KEY=replace-with-32-byte-pci-encryption-key!

# ── Settlement ────────────────────────────────────────────────────────────────
DEFAULT_CRYPTO_CURRENCY=USDT
SETTLEMENT_FEE_PERCENT=0.5
MIN_SETTLEMENT_AMOUNT_USD=1.0

# ── Fraud Detection ───────────────────────────────────────────────────────────
FRAUD_VELOCITY_WINDOW_SECONDS=3600
FRAUD_MAX_TRANSACTIONS_PER_CARD=10
FRAUD_MAX_AMOUNT_PER_TRANSACTION=50000.0
FRAUD_SUSPICIOUS_AMOUNT_THRESHOLD=10000.0
